+def _calibrar_limiar(stream, taxa_nativa) -> float:
+    """
+    Mede o ruído ambiente por 0.5s e define o limiar de fala acima dele,
+    em vez de usar um valor fixo que pode ser sensível demais em ambientes ruidosos
+    ou insensível demais com microfones fracos.
+    """
+    chunk, _ = stream.read(int(taxa_nativa * 0.5))
+    ruido_base = float(np.max(np.abs(chunk)))
+    limiar = max(SILENCIO_LIMIAR, ruido_base * 3)
+    return limiar
+
